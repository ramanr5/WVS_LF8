digraph G { graph [rankdir=TB, fontname="Helvetica", nodesep=0.4, ranksep=0.6, label="RPGGame – Klassendiagramm", labelloc=t, fontsize=16];
 node [shape=plaintext, fontname="Helvetica", fontsize=10];
 edge [fontname="Helvetica", fontsize=9];
"GameController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE9C7"><I>«Spielsteuerung»</I><BR/><B>GameController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- view : ConsoleView<BR ALIGN="LEFT"/>- random : Random<BR ALIGN="LEFT"/>- battle : BattleController<BR ALIGN="LEFT"/>- world : List&lt;Location&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GameController(view, random)<BR ALIGN="LEFT"/>+ Run()<BR ALIGN="LEFT"/>- ChooseLocation(player)<BR ALIGN="LEFT"/>- Explore(player, location)<BR ALIGN="LEFT"/>- VisitTown(player, town)<BR ALIGN="LEFT"/>- Shop(player, town)<BR ALIGN="LEFT"/>- ShowInventory(player)<BR ALIGN="LEFT"/>- ShowQuests(player)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"BattleController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE9C7"><I>«Spielsteuerung»</I><BR/><B>BattleController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- view : ConsoleView<BR ALIGN="LEFT"/>- random : Random<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ BattleController(view, random)<BR ALIGN="LEFT"/>+ Fight(player, monster)<BR ALIGN="LEFT"/>- TryFlee() : bool<BR ALIGN="LEFT"/>- DrinkPotion(player) : bool<BR ALIGN="LEFT"/>- ShowVictory(player, monster)<BR ALIGN="LEFT"/>- ShowDefeat(player)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"GameRules" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE9C7"><I>«static, Spielregeln»</I><BR/><B>GameRules</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ FleeChance = 50 {const}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CalculateDamage(attack, defense) : int<BR ALIGN="LEFT"/>+ Attack(attacker, defender) : int<BR ALIGN="LEFT"/>+ TryFlee(random) : bool<BR ALIGN="LEFT"/>+ UsePotion(player, potion) : int<BR ALIGN="LEFT"/>+ GainExperience(player, amount) : int<BR ALIGN="LEFT"/>+ GrantVictory(player, monster) : VictoryReward<BR ALIGN="LEFT"/>+ Revive(player)<BR ALIGN="LEFT"/>+ CanEnter(player, location) : bool<BR ALIGN="LEFT"/>+ TryBuy(player, offer) : bool<BR ALIGN="LEFT"/>+ Rest(player) : int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ConsoleView" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F5E1"><I>«View»</I><BR/><B>ConsoleView</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ShowTitle(title)<BR ALIGN="LEFT"/>+ ShowStatus(player)<BR ALIGN="LEFT"/>+ Menu(options) : int?<BR ALIGN="LEFT"/>+ Choose&lt;T&gt;(items, describe) : T?<BR ALIGN="LEFT"/>+ Pause()<BR ALIGN="LEFT"/>+ ParseChoice(input, count) : int? {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"GameData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF7C2"><I>«static, Daten»</I><BR/><B>GameData</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CreateWorld() : List&lt;Location&gt;<BR ALIGN="LEFT"/>+ CreatePlayer(name) : Player<BR ALIGN="LEFT"/>+ CreateMonster(name) : Monster<BR ALIGN="LEFT"/>+ Potion(), Sword(), Key() ... : Item<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Character" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEBFF"><I>«abstract»</I><BR/><B>Character</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Name : string {readOnly}<BR ALIGN="LEFT"/>+ MaxHealth : int<BR ALIGN="LEFT"/>+ Health : int<BR ALIGN="LEFT"/>+ BaseAttack : int<BR ALIGN="LEFT"/>+ BaseDefense : int<BR ALIGN="LEFT"/>+ /Attack : int<BR ALIGN="LEFT"/>+ /Defense : int<BR ALIGN="LEFT"/>+ /IsAlive : bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># Character(name, maxHealth, attack, defense)<BR ALIGN="LEFT"/>+ TakeDamage(amount) : int<BR ALIGN="LEFT"/>+ Heal(amount) : int<BR ALIGN="LEFT"/># IncreaseStats(maxHealth, attack, defense)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Player" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEBFF"><B>Player</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Level : int<BR ALIGN="LEFT"/>+ Experience : int<BR ALIGN="LEFT"/>+ Gold : int<BR ALIGN="LEFT"/>+ Inventory : Inventory {readOnly}<BR ALIGN="LEFT"/>+ Quests : IReadOnlyList&lt;Quest&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Player(name, gold = 50)<BR ALIGN="LEFT"/>+ AddGold(amount)<BR ALIGN="LEFT"/>+ TrySpendGold(amount) : bool<BR ALIGN="LEFT"/>+ AddExperience(amount)<BR ALIGN="LEFT"/>+ LevelUp(usedXp, hp, atk, def)<BR ALIGN="LEFT"/>+ AddQuest(quest) : bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Monster" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEBFF"><B>Monster</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ExperienceReward : int<BR ALIGN="LEFT"/>+ GoldReward : int<BR ALIGN="LEFT"/>+ Drop : Item?<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Monster(name, maxHealth, attack, defense, xp, gold, drop)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Inventory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEBFF"><B>Inventory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- items : List&lt;Item&gt;<BR ALIGN="LEFT"/>+ Items : IReadOnlyList&lt;Item&gt;<BR ALIGN="LEFT"/>+ Weapon : Item?<BR ALIGN="LEFT"/>+ Armor : Item?<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Add(item)<BR ALIGN="LEFT"/>+ Remove(item) : bool<BR ALIGN="LEFT"/>+ Equip(item) : bool<BR ALIGN="LEFT"/>+ Contains(item) : bool<BR ALIGN="LEFT"/>+ ContainsItemNamed(name) : bool<BR ALIGN="LEFT"/>+ GetItemsOfType(type) : List&lt;Item&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Item" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEBFF"><B>Item</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Name : string<BR ALIGN="LEFT"/>+ Description : string<BR ALIGN="LEFT"/>+ Type : ItemType<BR ALIGN="LEFT"/>+ Price : int<BR ALIGN="LEFT"/>+ Power : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Item(name, description, type, price, power)<BR ALIGN="LEFT"/>+ Copy() : Item<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Quest" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEBFF"><B>Quest</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Name : string<BR ALIGN="LEFT"/>+ Description : string<BR ALIGN="LEFT"/>+ TargetMonster : string<BR ALIGN="LEFT"/>+ RequiredKills : int<BR ALIGN="LEFT"/>+ RewardExperience : int<BR ALIGN="LEFT"/>+ RewardGold : int<BR ALIGN="LEFT"/>+ CurrentKills : int<BR ALIGN="LEFT"/>+ /IsCompleted : bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Quest(name, description, target, kills, xp, gold)<BR ALIGN="LEFT"/>+ RegisterKill(monsterName) : bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Location" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCEBFF"><B>Location</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Name : string<BR ALIGN="LEFT"/>+ Description : string<BR ALIGN="LEFT"/>+ RequiredItemName : string?<BR ALIGN="LEFT"/>+ MonsterNames : IReadOnlyList&lt;string&gt;<BR ALIGN="LEFT"/>+ ShopItems : IReadOnlyList&lt;Item&gt;<BR ALIGN="LEFT"/>+ /IsTown : bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Location(name, description, monsterNames, shopItems, requiredItemName)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ItemType" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EFEFEF"><I>«enumeration»</I><BR/><B>ItemType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Heiltrank<BR ALIGN="LEFT"/>Waffe<BR ALIGN="LEFT"/>Rüstung<BR ALIGN="LEFT"/>Schlüssel<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"GameController" -> "BattleController" [arrowhead=vee, headlabel="1"];
"GameController" -> "ConsoleView" [arrowhead=vee, headlabel="1"];
"BattleController" -> "ConsoleView" [arrowhead=vee, headlabel="1"];
"GameController" -> "Location" [arrowhead=vee, headlabel="1..*"];
"GameController" -> "GameRules" [arrowhead=vee, style=dashed, label="«use»"];
"BattleController" -> "GameRules" [arrowhead=vee, style=dashed, label="«use»"];
"GameController" -> "GameData" [arrowhead=vee, style=dashed, label="«use»"];
"Player" -> "Character" [arrowhead=onormal];
"Monster" -> "Character" [arrowhead=onormal];
"Player" -> "Inventory" [arrowtail=diamond, dir=both, arrowhead=vee, taillabel="1", headlabel="1"];
"Player" -> "Quest" [arrowtail=odiamond, dir=both, arrowhead=vee, taillabel="1", headlabel="0..*"];
"Inventory" -> "Item" [arrowtail=odiamond, dir=both, arrowhead=vee, taillabel="1", headlabel="0..*"];
"Monster" -> "Item" [arrowhead=vee, label="Drop", headlabel="0..1"];
"Location" -> "Item" [arrowhead=vee, label="ShopItems", headlabel="0..*"];
"Item" -> "ItemType" [arrowhead=vee, style=dashed];
"GameRules" -> "Player" [arrowhead=vee, style=dashed, label="«use»"];
}